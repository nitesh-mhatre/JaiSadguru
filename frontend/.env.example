# Copy to frontend/.env to override. All of these are optional and none are secrets.

# Leave unset in development: the Vite dev server proxies /api to localhost:8000.
# Set it when the dashboard is served from a different origin than the API.
# VITE_API_BASE=https://api.example.com

# Where the dev server proxies /api (defaults to http://localhost:8000).
# VITE_API_TARGET=http://localhost:8000
