# Copy to backend/.env and edit. Real environment variables always win over this file,
# so a shell export or container env is never shadowed by a stale local value.
#
# Nothing here is a secret. The project needs no API keys by design — market data comes
# from yfinance and model weights from public Hugging Face repos.

# ---------------------------------------------------------------------------
# Watchlist — comma-separated. Any yfinance ticker works; unknown symbols keep
# their ticker as the display name. Defaults to indices + gold + silver +
# crypto + NSE large-caps. This list SEEDS the database watchlist on first
# boot; symbols added or removed through the API/dashboard afterwards persist
# regardless of what is set here.
# Crypto pairs end in -USD; NSE stocks end in .NS (BSE: .BO).
# ---------------------------------------------------------------------------
# WATCHLIST=^GSPC,^NDX,^DJI,GC=F,SI=F,BTC-USD,ETH-USD,^NSEI,RELIANCE.NS,TCS.NS

# ---------------------------------------------------------------------------
# Search and watchlist limits
# ---------------------------------------------------------------------------
# Symbol-search results are cached in SQLite for this many minutes.
SEARCH_CACHE_TTL_MINUTES=1440
# Hard cap on tracked symbols, so a cycle stays inside yfinance rate limits.
MAX_WATCHLIST=25

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Default bar size. One of 1m, 5m, 15m, 30m, 1h, 1d, 1wk. Daily is the supported
# default: free yfinance intraday history is capped (7d at 1m, 60d at 5m-1h),
# far short of a daily-bar Kronos context. Treat intraday as best-effort.
# The dashboard can override this per request; the interval chosen there is also
# what the forecast runs on (5m selected = 5-minute prediction bars).
INTERVAL=1d
# Bars of context handed to the model. Must not exceed the chosen model's
# max_context (512 for kronos-small/base, 2048 for kronos-mini). Intraday
# intervals additionally cap LOOKBACK at 240 because their history is capped.
LOOKBACK=400
CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Kronos forecast
# ---------------------------------------------------------------------------
# kronos-mini (4.1M) | kronos-small (24.7M) | kronos-base (102.3M).
# kronos-large is not open-source. Use kronos-mini on CPU-only machines.
KRONOS_MODEL=kronos-small
# auto | cpu | cuda:0 | mps
DEVICE=auto
# Bars to forecast.
PRED_LEN=10
# Parallel sampled paths, averaged. Higher is smoother and slower.
SAMPLE_COUNT=3
TEMPERATURE=1.0
TOP_P=0.9

# ---------------------------------------------------------------------------
# Signal thresholds. `score` is the forecast return divided by the asset's own
# expected volatility over the horizon, so these are volatility-relative.
# ---------------------------------------------------------------------------
SIGNAL_BUY_THRESHOLD=0.55
SIGNAL_SELL_THRESHOLD=-0.55
MIN_CONFIDENCE=0.35
# Bars used to measure realised volatility.
VOL_LOOKBACK=60

# ---------------------------------------------------------------------------
# Paper-trading risk limits. ENFORCED by the engine, not advisory.
# ---------------------------------------------------------------------------
INITIAL_CAPITAL=100000
# Fraction of equity targeted per new position.
POSITION_PCT=0.20
# Hard cap on concurrent positions.
MAX_POSITIONS=5
# Hard cap on a single position's share of equity.
MAX_POSITION_PCT=0.30
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
COMMISSION_BPS=1.0
SLIPPAGE_BPS=2.0

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
# DB_PATH=./data/jaisadguru.db
# CACHE_DIR=./.cache
# Comma-separated allowed browser origins. Defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Off by default. Runs a cycle on an interval inside the API process, sharing
# the same lock as manual runs so cycles can never overlap.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
